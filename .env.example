# Cadena de conexion de Neon (Postgres). Copiala como .env.local y no la subas al repo.
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"

# Clave de la API de Ignav (busqueda de vuelos en vivo). Obtenla en https://ignav.com
IGNAV_API_KEY="ignav_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Pendiente / opcional:
# FLIGHTAPI_KEY=
